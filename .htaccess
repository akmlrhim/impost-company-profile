<IfModule mod_rewrite.c>
	RewriteEngine On

	RewriteRule (^|/)\. - [F,L]

	RewriteRule
	^(app|bootstrap|config|database|resources|routes|storage|tests|vendor|node_modules|lang|artisan|composer\.(json|lock)|package\.json|phpunit\.xml|webpack\.mix\.js|server\.php) - [F,L]

	RewriteCond %{THE_REQUEST} \s/public/
	RewriteRule ^public/(.*)$ /$1 [R=301,L]

	RewriteCond %{REQUEST_URI} !^/public/
	RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

Options -Indexes

<FilesMatch "(\.env.*|composer\.(json|lock)|artisan|phpunit\.xml|package\.json|\.gitignore|server\.php|webpack\.mix\.js)$">
	Order allow,deny
	Deny from all
</FilesMatch>