<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    RewriteCond %{THE_REQUEST} \s/public/ [NC]
    RewriteRule ^ - [R=404,L]

    RewriteRule ^(\.env|composer\.lock|composer\.json|\.git|storage/logs|artisan|phpunit\.xml) - [F,L]

    RewriteRule ^(app|bootstrap|config|database|resources|routes|storage|tests|vendor|node_modules|lang)/.*$ - [F,L]

    RewriteRule ^(.*)$ public/$1 [L]

</IfModule>
