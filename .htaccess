<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    RewriteRule ^public/?(.*)$ /$1 [R=301,L]

    RewriteRule ^(\.env|composer\.lock|composer\.json|\.git|storage/logs|artisan|phpunit\.xml) - [F,L]

    RewriteRule ^(app|bootstrap|config|database|resources|routes|storage|tests|vendor|node_modules|lang)/.*$ - [F,L]

    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]np

</IfModule>
