# Root .htaccess (Versi Anti-Loop)

<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    RewriteRule ^(\.env|composer\.lock|composer\.json|\.git|storage/logs) - [F,L]

    RewriteRule ^(.*)$ public/$1 [L]

</IfModule>
